# Configuration Validation
class SecureConfig(BaseSettings):
    WEB3_PROVIDER_URL: AnyUrl = Field(..., env="WEB3_PROVIDER_URL")
    DATABASE_URL: PostgresDsn = Field(..., env="DATABASE_URL")
    TWEETSCOUT_API_KEY: str = Field(..., env="TWEETSCOUT_API_KEY")
    RUGCHECK_API_KEY: str = Field(..., env="RUGCHECK_API_KEY")
    TG_API_KEY: str = Field(..., env="TELEGRAM_API_KEY")
    
    class Config:
        secrets_dir = '/run/secrets'
        validate_all = True

try:
    config = SecureConfig()
except ValidationError as e:
    logging.critical(f"Configuration error: {str(e)}")
    raise SystemExit(1)

# Secure Database Setup
class AsyncDatabaseManager:
    def __init__(self):
        self.engine = create_async_engine(
            config.DATABASE_URL,
            pool_size=20,
            max_overflow=10,
            pool_pre_ping=True,
            echo=False
        )
        self.session_factory = sessionmaker(
            bind=self.engine,
            class_=AsyncSession,
            expire_on_commit=False,
            autoflush=False
        )

    @asynccontextmanager
    async def get_session(self):
        session = self.session_factory()
        try:
            yield session
            await session.commit()
        except Exception as e:
            await session.rollback()
            logging.error(f"Database operation failed: {str(e)}")
            raise
        finally:
            await session.close()

# Web3 Transaction Safety
class SecureWeb3Client:
    def __init__(self):
        self.w3 = Web3(Web3.AsyncHTTPProvider(config.WEB3_PROVIDER_URL))
        self.chain_id = None
        self.nonce_cache = {}
        
    async def initialize(self):
        self.chain_id = await self.w3.eth.chain_id
        logging.info(f"Connected to chain {self.chain_id}")
        
    @retry(
        stop=stop_after_attempt(3),
        wait=wait_chain(*[wait_fixed(3) for _ in range(3)])
    )
    async def send_secure_tx(self, tx_params: Dict) -> HexStr:
        """Execute transaction with safety checks"""
        if not self._validate_address(tx_params['to']):
            raise ValueError("Invalid recipient address")
            
        try:
            # Gas estimation with buffer
            gas_estimate = await self.w3.eth.estimate_gas(tx_params) 
            tx_params['gas'] = int(gas_estimate * 1.2)
            
            # Nonce management
            sender = tx_params['from']
            tx_params['nonce'] = await self._get_nonce(sender)
            
            # Sign and send
            signed_tx = self.w3.eth.account.sign_transaction(
                tx_params, private_key
            )
            tx_hash = await self.w3.eth.send_raw_transaction(
                signed_tx.rawTransaction
            )
            
            # Wait for confirmation
            await self._wait_for_confirmation(tx_hash)
            return tx_hash.hex()
            
        except ContractLogicError as e:
            logging.error(f"Contract error: {str(e)}")
            raise
        except Exception as e:
            logging.error(f"Transaction failed: {str(e)}")
            await self._clear_nonce_cache(sender)
            raise

    def _validate_address(self, address: str) -> bool:
        return Web3.is_address(address) and Web3.is_checksum_address(address)
        
    async def _get_nonce(self, address: str) -> int:
        if address not in self.nonce_cache:
            self.nonce_cache[address] = await self.w3.eth.get_transaction_count(address)
        return self.nonce_cache[address]
        
    async def _wait_for_confirmation(self, tx_hash: HexStr, confirmations=3):
        """Wait for blockchain confirmations"""
        receipt = None
        while not receipt or receipt['blockNumber'] is None:
            await asyncio.sleep(5)
            receipt = await self.w3.eth.get_transaction_receipt(tx_hash)
            
        latest_block = await self.w3.eth.block_number
        while latest_block - receipt['blockNumber'] < confirmations:
            await asyncio.sleep(15)
            latest_block = await self.w3.eth.block_number

# Secure API Client
class SecureAPIClient:
    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update({
            "Accept": "application/json",
            "User-Agent": "SecureTradingBot/1.0"
        })
        
    @retry(stop=stop_after_attempt(3), wait=wait_fixed(2))
    async def get_rugcheck_report(self, contract_address: str) -> Dict:
        try:
            response = await self.session.get(
                f"{RUGCHECK_URL}/contracts/{contract_address}",
                headers={"Authorization": f"Bearer {config.RUGCHECK_API_KEY}"}
            )
            response.raise_for_status()
            return response.json()
        except requests.HTTPError as e:
            if e.response.status_code == 401:
                logging.error("Invalid Rugcheck API credentials")
                raise SystemExit(1)
            raise

# Security Middleware
class SecurityFilters(logging.Filter):
    def filter(self, record):
        for secret in [
            config.TG_API_KEY,
            config.RUGCHECK_API_KEY,
            config.WEB3_PROVIDER_URL
        ]:
            if secret and secret in record.getMessage():
                record.msg = record.msg.replace(secret, "***REDACTED***")
        return True

logging.getLogger().addFilter(SecurityFilters())

