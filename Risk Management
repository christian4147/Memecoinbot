# Security Configuration
class SecurityConfig:
    RUGCHECK_RATE_LIMIT = RequestRate(5, Duration.MINUTE)  # 5 requests/minute
    FALLBACK_PROVIDERS = [
        os.getenv("WEB3_FALLBACK_PROVIDER1"),
        os.getenv("WEB3_FALLBACK_PROVIDER2")
    ]
    VOLATILITY_WINDOW = 24  # hours
    RISK_FREE_RATE = 0.02  # Annualized

# Rate Limiter Instance
limiter = Limiter(SecurityConfig.RUGCHECK_RATE_LIMIT)

class EnhancedSecurity:
    def __init__(self):
        self.w3 = self._init_web3_with_failover()
        self.aiohttp_session = aiohttp.ClientSession()
        self.volatility_cache = {}

    def _init_web3_with_failover(self) -> Web3:
        """Initialize Web3 with provider failover"""
        for provider in [SecurityConfig.FALLBACK_PROVIDERS[0]] + SecurityConfig.FALLBACK_PROVIDERS[1:]:
            try:
                w3 = Web3(Web3.HTTPProvider(provider))
                if w3.is_connected():
                    return w3
            except Exception:
                continue
        raise ConnectionError("All Web3 providers unavailable")

    @retry(stop=stop_after_attempt(3), 
           wait=wait_exponential(multiplier=1, min=2, max=10),
           retry=retry_if_exception_type((aiohttp.ClientError, TimeoutError)))
    @limiter.ratelimit("rugcheck", delay=True)
    async def rugcheck_verification(self, contract_address: ChecksumAddress) -> bool:
        """Comprehensive Rugcheck integration with rate limiting"""
        try:
            headers = {"Authorization": f"Bearer {os.getenv('RUGCHECK_API_KEY')}"}
            async with self.aiohttp_session.get(
                f"{SecurityConfig.RUGCHECK_API}/contracts/{contract_address}/report",
                headers=headers
            ) as response:
                if response.status == 429:
                    raise RateLimitException("Rugcheck API rate limit exceeded")
                
                data = await response.json()
                return self._parse_rugcheck_report(data)
                
        except Exception as e:
            logging.error(f"Rugcheck verification failed: {str(e)}")
            return False

    def _parse_rugcheck_report(self, report: Dict) -> bool:
        """Analyze Rugcheck security report"""
        if report['status'] != 'safe':
            return False
            
        risk_factors = {
            'is_mintable': report['contractAnalysis'].get('mintable', False),
            'lp_locked': report['lpAnalysis']['locked'],
            'owner_centralization': report['ownerAnalysis']['ownerCount'] < 2
        }
        return not any(risk_factors.values())

    async def enhanced_blacklist_check(self, address: str) -> bool:
        """Normalized blacklist verification"""
        checksum_addr = Web3.to_checksum_address(address)
        normalized_blacklist = {
            Web3.to_checksum_address(addr) 
            for addr in SecurityConfig.BLACKLISTS['CONTRACT']
        }
        return checksum_addr in normalized_blacklist

