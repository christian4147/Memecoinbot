class AdaptiveRiskManager:
    def __init__(self, portfolio_value: float):
        self.portfolio_value = portfolio_value
        self.volatility_cache = {}

    async def calculate_position_size(self, volatility: float) -> float:
        """Kelly Criterion-based position sizing"""
        kelly_fraction = (volatility - SecurityConfig.RISK_FREE_RATE) / volatility**2
        return min(
            self.portfolio_value * kelly_fraction,
            SecurityConfig.MAX_POSITION_ABS
        )

    async def dynamic_stop_loss(self, volatility: float) -> float:
        """Volatility-adjusted stop loss"""
        base_sl = SecurityConfig.BASE_STOP_LOSS
        return base_sl * (1 + volatility / SecurityConfig.VOLATILITY_THRESHOLD)

    async def get_volatility(self, pair_address: ChecksumAddress) -> float:
        """Calculate hourly price volatility"""
        if pair_address not in self.volatility_cache:
            historical_prices = await self._fetch_ohlcv(pair_address)
            returns = np.diff(np.log(historical_prices['close']))
            self.volatility_cache[pair_address] = np.std(returns) * np.sqrt(24)
            
        return self.volatility_cache[pair_address]

