class RateLimitException(Exception):
    pass

limiter = Limiter(RiskSecurityConfig.RUGCHECK_RATE_LIMIT)

class EnhancedSecurity:
    def __init__(self):
        self.w3 = self._init_web3_with_failover()
        self.aiohttp_session = aiohttp.ClientSession()
        self.volatility_cache = {}

    def _init_web3_with_failover(self) -> Web3:
        for provider in RiskSecurityConfig.FALLBACK_PROVIDERS:
            try:
                w3 = Web3(Web3.HTTPProvider(provider))
                if w3.is_connected():
                    return w3
            except Exception:
                continue
        raise ConnectionError("All Web3 providers unavailable")

    @retry(
        stop=stop_after_attempt(3), 
        wait=wait_exponential(multiplier=1, min=2, max=10),
        retry=retry_if_exception_type((aiohttp.ClientError, TimeoutError))
    )
    @limiter.ratelimit("rugcheck", delay=True)
    async def rugcheck_verification(self, contract_address: ChecksumAddress) -> bool:
        try:
            headers = {"Authorization": f"Bearer {os.getenv('RUGCHECK_API_KEY')}"}
            url = f"{RiskSecurityConfig.RUGCHECK_API}/contracts/{contract_address}/report"
            async with self.aiohttp_session.get(url, headers=headers) as response:
                if response.status == 429:
                    raise RateLimitException("Rugcheck API rate limit exceeded")
                data = await response.json()
                return self._parse_rugcheck_report(data)
        except Exception as e:
            logger.error(f"Rugcheck verification failed: {str(e)}")
            return False

    def _parse_rugcheck_report(self, report: Dict) -> bool:
        if report.get('status') != 'safe':
            return False
        risk_factors = {
            'is_mintable': report.get('contractAnalysis', {}).get('mintable', False),
            'lp_locked': report.get('lpAnalysis', {}).get('locked', False),
            'owner_centralization': report.get('ownerAnalysis', {}).get('ownerCount', 0) < 2
        }
        return not any(risk_factors.values())

    async def enhanced_blacklist_check(self, address: str) -> bool:
        checksum_addr = Web3.to_checksum_address(address)
        normalized_blacklist = {
            Web3.to_checksum_address(addr) 
            for addr in RiskSecurityConfig.BLACKLISTS['CONTRACT']
        }
        return checksum_addr in normalized_blacklist

    async def social_verification(self, contract_address: ChecksumAddress) -> Dict:
        analysis = {
            'account_age': None,
            'engagement': None,
            'sentiment': None
        }
        try:
            url = f"{RiskSecurityConfig.TWEETSCOUT_API}/analysis/{contract_address}"
            headers = {"Authorization": f"Bearer {os.getenv('TWEETSCOUT_API_KEY')}"}
            async with self.aiohttp_session.get(url, headers=headers) as response:
                social_data = await response.json()
            analysis.update({
                'account_age': (datetime.now() - datetime.fromisoformat(social_data['created_at'])).days,
                'engagement': social_data.get('engagement_rate'),
                'sentiment': self._analyze_sentiment(social_data.get('recent_tweets', []))
            })
        except Exception as e:
            logger.error(f"Social verification failed: {str(e)}")
        return analysis

    def _analyze_sentiment(self, tweets: List[str]) -> float:
        positive_words = {'bullish', 'moon', 'growth'}
        negative_words = {'scam', 'rug', 'dump'}
        scores = []
        for tweet in tweets:
            words = set(tweet.lower().split())
            score = len(words & positive_words) - len(words & negative_words)
            scores.append(score)
        return np.mean(scores) if scores else 0

