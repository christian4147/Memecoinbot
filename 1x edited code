        self.trade_settings = {'MAX_TRADES_PER_DAY': 5}

    async def concurrent_main(self):
        self.running = True
        await self.web3_client.initialize()
        asyncio.create_task(self._run_quantitative_analysis())
        await asyncio.gather(
            self.tg_bot.app.run_polling(),
            self.analyze_and_trade(),
            self.process_alerts()
        )
        
    async def _run_quantitative_analysis(self):
        while self.running:
            try:
                await self.quant_system.analyze_market()
                self.quant_system.backtest_strategy(days=90)
                await asyncio.sleep(3600)
            except Exception as e:
                self.logger.error(f"Quantitative analysis error: {str(e)}", exc_info=True)
                await asyncio.sleep(60)
        
    async def analyze_and_trade(self):
        while self.running:
            try:
                coins = await self._get_new_listings()
                for coin in coins:
                    if await self.secure_executor._validate_contract(coin['contract']):
                        trade_data = await self.secure_executor.execute_trade({
                            'address': coin['contract'],
                            'pair': coin.get('pair', coin['contract'])
                        })
                        if not trade_data:
                            self.logger.warning(f"Trade execution failed for {coin.get('symbol')}")
                            continue
                        await self._log_trade(trade_data)
                        alert_message = self._format_trade_alert(
                            coin['symbol'],
                            coin['contract'],
                            trade_data
                        )
                        await self.tg_bot.send_alert(alert_message)
                        self.trade_count += 1
                        if self.trade_count >= self.trade_settings['MAX_TRADES_PER_DAY']:
                            self.logger.info("Reached max trades per day limit.")
                            self.running = False
                            break
                await asyncio.sleep(60)
            except Exception as e:
                self.logger.error(f"Trade loop error: {str(e)}", exc_info=True)
                await asyncio.sleep(30)
                
    async def process_alerts(self):
        while self.running:
            alert = await self.tg_bot.queue.get()
            self.logger.info(f"Processing alert: {alert}")
            self.tg_bot.queue.task_done()
            
    async def _get_new_listings(self) -> List[Dict]:
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get("https://api.pumpfun.com/v1") as response:
                    data = await response.json()
                    return data
        except Exception as e:
            self.logger.error(f"Error fetching new listings: {str(e)}", exc_info=True)
            return []
                
    async def _log_trade(self, data: Dict):
        try:
            async with self.db_manager.get_session() as session:
                trade = TradedCoin(
                    contract_address=data.get('contract'),
                    symbol=data.get('symbol', 'N/A'),
                    trade_data=data,
                    analysis_data=data
                )
                session.add(trade)
        except Exception as e:
            self.logger.error(f"DB logging failed: {str(e)}", exc_info=True)
        
    def _format_trade_alert(self, symbol: str, contract: str, analysis: Dict) -> str:
        return (
            f"*New Trade Executed*\n"
            f"🏷 {symbol} | `{contract}`\n"
            f"📈 Details: {analysis}\n"
            f"🔗 [Chart](https://dexscreener.com/{contract})"
        )
        
    async def shutdown(self):
        self.logger.info("Initiating shutdown sequence")
        self.running = False
        try:
            await self.web3_client.w3.provider.disconnect()
        except Exception as e:
            self.logger.error(f"Error disconnecting web3 provider: {str(e)}", exc_info=True)
        try:
            await self.db_manager.engine.dispose()
        except Exception as e:
            self.logger.error(f"Error disposing db engine: {str(e)}", exc_info=True)
        self.logger.info("Resources released. Shutdown complete")
        
    async def handle_signal(self):
        self.logger.info("Received termination signal")
        await self.shutdown()
        tasks = [t for t in asyncio.all_tasks() if t is not asyncio.current_task()]
        for task in tasks:
            task.cancel()
        await asyncio.gather(*tasks, return_exceptions=True)
        asyncio.get_event_loop().stop()

# ------------------------------------------------------------------------------
# Signal Handling & Main Entry
# ------------------------------------------------------------------------------
def setup_signals(system: AsyncTradingSystem):
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, lambda: asyncio.create_task(system.handle_signal()))

async def main():
    system = AsyncTradingSystem()
    setup_signals(system)
    
    try:
        await system.concurrent_main()
    except Exception as e:
        system.logger.critical(f"Unexpected error: {str(e)}", exc_info=True)
    finally:
        if system.running:
            await system.shutdown()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
