            return None

    async def _validate_contract(self, address: str) -> bool:
        checksum_addr = Web3.to_checksum_address(address)
        validations = [
            self.security.enhanced_blacklist_check(checksum_addr),
            self.security.rugcheck_verification(checksum_addr),
            self._check_onchain_suspicious_activity(checksum_addr)
        ]
        results = await asyncio.gather(*validations)
        return all(results)

    async def _check_onchain_suspicious_activity(self, address: ChecksumAddress) -> bool:
        try:
            recent_txs = await self.security.w3.eth.get_transactions(address)
            large_transfers = [tx for tx in recent_txs if tx.get('value', 0) > RiskSecurityConfig.LARGE_TX_THRESHOLD]
            return len(large_transfers) < RiskSecurityConfig.SUSPICIOUS_TX_COUNT
        except Exception:
            return False

